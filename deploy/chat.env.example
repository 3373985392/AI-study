# 复制到 /etc/ai-study/chat.env，并设置 deploy:deploy、0600 权限。
LLM_API_KEY=replace-with-real-key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_READ_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=2048
LLM_CONTEXT_WINDOW_TOKENS=32768
# LLM_MEMORY_MODEL=qwen-plus
LLM_MEMORY_TRIGGER_TOKENS=16000
LLM_MEMORY_RECENT_ROUNDS=4
LLM_MEMORY_MAX_INPUT_TOKENS=12000
LLM_MEMORY_MAX_OUTPUT_TOKENS=800
LLM_MAX_RETRIES=2
LLM_INPUT_PRICE_PER_MILLION=0
LLM_OUTPUT_PRICE_PER_MILLION=0
EMBEDDING_API_KEY=replace-with-real-key
EMBEDDING_BASE_URL=https://cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
CHAT_MODEL=qwen3-max

INVITE_CODE_PEPPER=replace-with-at-least-32-random-characters
SESSION_TOKEN_PEPPER=replace-with-another-32-random-characters
ADMIN_PASSWORD_HASH=replace-with-output-from-admin-credentials-command
ADMIN_SESSION_TOKEN_PEPPER=replace-with-a-third-32-random-characters
ADMIN_SESSION_HOURS=8
ADMIN_LOGIN_ATTEMPT_LIMIT=5
CHAT_DATABASE_PATH=/var/lib/ai-study/chat.sqlite3
CHAT_COOKIE_SECURE=true
CHAT_ALLOWED_ORIGINS=https://chienzz.top
CHAT_SESSION_DAYS=30
CHAT_MINUTE_LIMIT=5
CHAT_DAY_LIMIT=50
CHAT_LOGIN_ATTEMPT_LIMIT=5
CHAT_METADATA_RETENTION_DAYS=90
CHAT_CONVERSATION_RETENTION_DAYS=365
CHAT_SSE_HEARTBEAT_SECONDS=15
RAG_MIN_VECTOR_SCORE=0.35
