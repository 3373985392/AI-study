# 普通 CLI Chat 模型配置
LLM_API_KEY=replace-with-your-api-key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# Minimal RAG 的 Embedding 与回答模型配置
EMBEDDING_API_KEY=replace-with-your-api-key
EMBEDDING_BASE_URL=https://cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
CHAT_MODEL=qwen3-max

# Web Chat 邀请码、会话与限额配置
# 两个 Pepper 必须分别生成，生产环境建议使用：python -c "import secrets; print(secrets.token_urlsafe(48))"
INVITE_CODE_PEPPER=replace-with-at-least-32-random-characters
SESSION_TOKEN_PEPPER=replace-with-another-32-random-characters
CHAT_DATABASE_PATH=projects/cli-chat/data/chat.sqlite3
CHAT_COOKIE_SECURE=false
CHAT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CHAT_SESSION_DAYS=30
CHAT_MINUTE_LIMIT=5
CHAT_DAY_LIMIT=50
CHAT_LOGIN_ATTEMPT_LIMIT=5
CHAT_METADATA_RETENTION_DAYS=90
